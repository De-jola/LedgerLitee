rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection Health Check Endpoint
    match /test/{docId} {
      allow get: if true;
    }

    // Core Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adejolanu@gmail.com' &&
        request.auth.token.email_verified == true
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Entity Validators
    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.type in ['income', 'expense'] &&
             data.amount is number && data.amount >= 0 &&
             data.date is string && data.date.size() <= 30 &&
             data.title is string && data.title.size() <= 255 &&
             data.category is string && data.category.size() <= 100 &&
             data.paymentMethod in ['cash', 'pos_agent', 'bank_transfer', 'other'] &&
             data.payerOrPayee is string && data.payerOrPayee.size() <= 255 &&
             data.referenceNumber is string && data.referenceNumber.size() <= 100 &&
             data.createdAt is number &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('posAgentName' in data) || (data.posAgentName is string && data.posAgentName.size() <= 150)) &&
             (!('barcodeOrQrCode' in data) || (data.barcodeOrQrCode is string && data.barcodeOrQrCode.size() <= 1000)) &&
             (!('receiptPhotoUrl' in data) || (data.receiptPhotoUrl is string && data.receiptPhotoUrl.size() <= 500000)) &&
             (!('verified' in data) || data.verified is bool);
    }

    function isValidInvoice(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.invoiceNumber is string && data.invoiceNumber.size() <= 100 &&
             data.date is string && data.date.size() <= 30 &&
             data.dueDate is string && data.dueDate.size() <= 30 &&
             data.customerName is string && data.customerName.size() <= 255 &&
             data.total is number && data.total >= 0 &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.balanceDue is number && data.balanceDue >= 0 &&
             data.status in ['unpaid', 'paid', 'partially_paid', 'cancelled'] &&
             data.createdAt is number &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50)) &&
             (!('customerAddress' in data) || (data.customerAddress is string && data.customerAddress.size() <= 255)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('paymentInstructions' in data) || (data.paymentInstructions is string && data.paymentInstructions.size() <= 1000));
    }

    function isValidIssuedReceipt(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.receiptNumber is string && data.receiptNumber.size() <= 100 &&
             data.date is string && data.date.size() <= 30 &&
             data.customerName is string && data.customerName.size() <= 255 &&
             data.description is string && data.description.size() <= 500 &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.paymentMethod in ['cash', 'pos_agent', 'bank_transfer', 'other'] &&
             data.createdAt is number &&
             (!('invoiceId' in data) || (data.invoiceId is string && data.invoiceId.size() <= 128)) &&
             (!('posAgentName' in data) || (data.posAgentName is string && data.posAgentName.size() <= 150)) &&
             (!('customerPhone' in data) || (data.customerPhone is string && data.customerPhone.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidBusinessProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.businessName is string && data.businessName.size() <= 200 &&
             data.ownerName is string && data.ownerName.size() <= 150 &&
             data.currency is string && data.currency.size() <= 10 &&
             data.currencySymbol is string && data.currencySymbol.size() <= 10 &&
             (!('businessType' in data) || data.businessType in ['school', 'shop', 'services', 'general']) &&
             (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 255)) &&
             (!('communityLocation' in data) || (data.communityLocation is string && data.communityLocation.size() <= 200)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('bankAccountDetails' in data) || (data.bankAccountDetails is string && data.bankAccountDetails.size() <= 500));
    }

    function isValidStaffMember(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.role is string && data.role.size() <= 150 &&
             data.roleType in ['owner', 'manager', 'cashier', 'viewer'] &&
             data.monthlySalary is number && data.monthlySalary >= 0 &&
             data.status in ['active', 'on_leave'] &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('lastPaidDate' in data) || (data.lastPaidDate is string && data.lastPaidDate.size() <= 30));
    }

    function isValidAppUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.fullName is string && data.fullName.size() <= 150 &&
             data.role in ['owner', 'manager', 'cashier', 'viewer', 'admin'] &&
             data.createdAt is number &&
             (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 50)) &&
             (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200)) &&
             (!('businessType' in data) || data.businessType in ['school', 'shop', 'services', 'general']) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('authProvider' in data) || (data.authProvider is string && data.authProvider.size() <= 50)) &&
             (!('lastLoginAt' in data) || data.lastLoginAt is number);
    }

    // Collection: Users (LedgerLite Registered Accounts)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (isAdmin() || resource.data.id == request.auth.uid || resource.data.uid == request.auth.uid);
      allow create: if isValidId(userId) &&
                      isSignedIn() &&
                      (request.auth.uid == userId || incoming().id == request.auth.uid) &&
                      isValidAppUser(incoming());
      allow update: if isValidId(userId) &&
                      isSignedIn() &&
                      (request.auth.uid == userId || isAdmin()) &&
                      incoming().createdAt == existing().createdAt &&
                      isValidAppUser(incoming());
      allow delete: if isValidId(userId) && isSignedIn() && isAdmin();
    }

    // Collection: Transactions
    match /transactions/{transactionId} {
      allow get: if isValidId(transactionId) && isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(transactionId) &&
                      isSignedIn() &&
                      incoming().userId == request.auth.uid &&
                      isValidTransaction(incoming());
      allow update: if isValidId(transactionId) &&
                      isSignedIn() &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      isValidTransaction(incoming());
      allow delete: if isValidId(transactionId) && isSignedIn() && isOwner(existing().userId);
    }

    // Collection: Invoices
    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(invoiceId) &&
                      isSignedIn() &&
                      incoming().userId == request.auth.uid &&
                      isValidInvoice(incoming());
      allow update: if isValidId(invoiceId) &&
                      isSignedIn() &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      isValidInvoice(incoming());
      allow delete: if isValidId(invoiceId) && isSignedIn() && isOwner(existing().userId);
    }

    // Collection: Issued Receipts
    match /issued_receipts/{receiptId} {
      allow get: if isValidId(receiptId) && isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(receiptId) &&
                      isSignedIn() &&
                      incoming().userId == request.auth.uid &&
                      isValidIssuedReceipt(incoming());
      allow update: if isValidId(receiptId) &&
                      isSignedIn() &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      incoming().createdAt == existing().createdAt &&
                      isValidIssuedReceipt(incoming());
      allow delete: if isValidId(receiptId) && isSignedIn() && isOwner(existing().userId);
    }

    // Collection: Business Profiles
    match /business_profiles/{profileId} {
      allow get: if isValidId(profileId) && isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(profileId) &&
                      isSignedIn() &&
                      incoming().userId == request.auth.uid &&
                      isValidBusinessProfile(incoming());
      allow update: if isValidId(profileId) &&
                      isSignedIn() &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      isValidBusinessProfile(incoming());
      allow delete: if isValidId(profileId) && isSignedIn() && isOwner(existing().userId);
    }

    // Collection: Staff Members
    match /staff/{staffId} {
      allow get: if isValidId(staffId) && isSignedIn() && isOwner(existing().userId);
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(staffId) &&
                      isSignedIn() &&
                      incoming().userId == request.auth.uid &&
                      isValidStaffMember(incoming());
      allow update: if isValidId(staffId) &&
                      isSignedIn() &&
                      existing().userId == request.auth.uid &&
                      incoming().userId == existing().userId &&
                      isValidStaffMember(incoming());
      allow delete: if isValidId(staffId) && isSignedIn() && isOwner(existing().userId);
    }
  }
}
